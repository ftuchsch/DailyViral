# Local queue defaults; publishing requires deliberate opt-in.
AUTO_POST_ENABLED=false
CONFIRM_BEFORE_POSTING=true
DRY_RUN=true

# Only official HTTPS Meta API origins are accepted.
GRAPH_API_BASE_URL=https://graph.instagram.com
GRAPH_API_VERSION=v23.0
PUBLISHING_LIMIT_BUFFER=1
HTTP_TIMEOUT_SECONDS=20

# Account configuration; leave credentials empty until configured locally.
INSTAGRAM_USERNAME=your_instagram_username
IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Local queue only: use a direct HTTPS video, never a private R2 source URL.
DAILYVIRAL_VIDEO_URL=https://example.com/video.mp4

# Private R2 publishing. Do not enable r2.dev or connect public custom domains.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SECURITY_API_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_BASE_VIDEO_KEY=base/video.mp4
R2_SIGNED_URL_TTL_SECONDS=900

# Stateless daily series.
ENABLE_VIDEO_OVERLAY=false
DAILYVIRAL_START_DATE=
DAILYVIRAL_TIMEZONE=America/New_York
DAILYVIRAL_CAPTION_TEMPLATE="Day {day_number} of posting this meme"
DAILYVIRAL_HASHTAGS="#meme #reels #daily"
